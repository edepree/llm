#!/usr/bin/env bash
set -euo pipefail

read -rp "Target endpoint (e.g. host.example.com): " host
if [[ -z "$host" ]]; then
  echo "Error: target endpoint is required" >&2
  exit 1
fi

if [[ "$host" == "localhost" || "$host" == "127.0.0.1" ]]; then
  uv run --no-lock ansible-playbook \
    -i "${host}," \
    --connection=local \
    --ask-become-pass \
    setup.yml
else
  uv run --no-lock ansible-playbook \
    -i "${host}," \
    --ask-pass \
    --ask-become-pass \
    setup.yml
fi
