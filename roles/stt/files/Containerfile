# FastFlowLM for the AMD XDNA 2 NPU. XRT comes from Ubuntu universe as a package dependency,
# so the host needs only the amdxdna kernel driver and NPU firmware.

FROM docker.io/library/ubuntu:26.04
ARG FLM_VERSION
RUN test -n "${FLM_VERSION}" || { echo "ERROR: FLM_VERSION build arg is required"; exit 1; } \
  && apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && curl -fsSLo /tmp/flm.deb "https://github.com/ROCm/FastFlowLM/releases/download/v${FLM_VERSION}/fastflowlm_${FLM_VERSION}_ubuntu26.04_amd64.deb" \
  && apt-get install -y --no-install-recommends /tmp/flm.deb \
  && rm -rf /var/lib/apt/lists/* /tmp/flm.deb
ENTRYPOINT ["flm"]
