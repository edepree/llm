[Unit]
Description=llama.cpp router server (multi-model)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={{ llamacpp_prefix }}/llama-server \
  --host 0.0.0.0 \
  --port {{ llamacpp_port }} \
  --models-preset %h/.config/llamacpp/presets.ini \
  {% set enabled_models = models | selectattr('enabled') | list %}
  {% set autoload_count = enabled_models | rejectattr('autoload', 'equalto', false) | list | length %}
  {% if autoload_count > 0 %}--models-autoload \
  {% else %}--no-models-autoload \
  {% endif %}--models-max {{ enabled_models | length }}

Environment=LD_LIBRARY_PATH={{ llamacpp_prefix }}
Environment=HSA_OVERRIDE_GFX_VERSION=11.5.1
Environment=HIP_VISIBLE_DEVICES=0
Environment=HF_XET_HIGH_PERFORMANCE=1
Environment=LLAMA_CACHE=%h/.cache/llama.cpp

Restart=on-failure
RestartSec=5s
LimitMEMLOCK=infinity
LimitNOFILE=1048576

[Install]
WantedBy=default.target
