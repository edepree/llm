[Unit]
Description=llama.cpp router server (multi-model)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Router mode: no -m / -hf flag at the top level; children are spawned
# per preset section. --models-max caps how many load concurrently.
ExecStart={{ llamacpp_prefix }}/bin/llama-server \
  --host 0.0.0.0 \
  --port {{ llamacpp_port }} \
  --models-preset %h/.config/llamacpp/presets.ini \
  --models-max {{ models | selectattr('enabled') | list | length }}

Environment=HSA_OVERRIDE_GFX_VERSION=11.5.1
Environment=HIP_VISIBLE_DEVICES=0
Environment=HF_XET_HIGH_PERFORMANCE=1
Environment=LLAMA_CACHE=%h/.cache/llama.cpp

Restart=on-failure
RestartSec=5s
LimitMEMLOCK=infinity
LimitNOFILE=1048576

[Install]
WantedBy=default.target
