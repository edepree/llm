[Unit]
Description=llama.cpp server ({{ model.name }})
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={{ llamacpp_prefix }}/llama-server --host 127.0.0.1 --port {{ model.port }} --hf-repo {{ model['hf-repo'] }} --ctx-size {{ model.ctx_size }}{% for k, v in llamacpp_common.items() %} --{{ k }} {{ v }}{% endfor %}{% for f in llamacpp_flags %} --{{ f }}{% endfor %}{% for k, v in (model.sampling | default({})).items() %} --{{ k }} {{ v }}{% endfor %}{% for k, v in (model.extra_args | default({})).items() %} --{{ k }} {{ v }}{% endfor %}

Environment=LD_LIBRARY_PATH={{ llamacpp_prefix }}
Environment=HSA_OVERRIDE_GFX_VERSION=11.5.1
Environment=HIP_VISIBLE_DEVICES=0
Environment=HF_XET_HIGH_PERFORMANCE=1
Environment=LLAMA_CACHE=%h/.cache/llama.cpp

Restart=on-failure
RestartSec=5s
LimitMEMLOCK=infinity
LimitNOFILE=1048576

[Install]
WantedBy=default.target
