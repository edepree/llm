version = 1

[*]
{% for k, v in llamacpp_common.items() -%}
{{ k }} = {{ v }}
{% endfor %}
{% for m in models | selectattr('enabled') | list %}
[{{ m.name }}]
hf = {{ m['hf-repo'] }}
ctx-size = {{ m.ctx_size }}
load-on-startup = {{ '1' if m.autoload | default(true) else '0' }}
{% if m.aliases is defined -%}
alias = {{ m.aliases }}
{% endif -%}
{% for k, v in (m.sampling | default({})).items() -%}
{{ k }} = {{ v }}
{% endfor -%}
{% for k, v in (m.extra_args | default({})).items() -%}
{{ k }} = {{ v }}
{% endfor %}
{% endfor %}
