[Container]
Image={{ openwebui_image }}
Name=openwebui
PublishPort={{ openwebui_port }}:8080
Volume=openwebui-data:/app/backend/data
RestartPolicy=unless-stopped
Env=OPENAI_API_BASE_URLS=http://127.0.0.1:{{ litellm_port }}
Env=OPENAI_API_KEYS=dummy-key
Env=WEBUI_AUTH=false
Env=PORT=8080
Env=HOST=0.0.0.0

[Install]
WantedBy=default.target
